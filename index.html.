.panel,.hero{border:1px solid var(--line);border-radius:22px;background:linear-gradient(145deg,#101b3b,#080e23);padding:19px;box-shadow:0 16px 45px #0005}.hero{text-align:center;padding:30px 16px;background:radial-gradient(ellipse at 50% 30%,#25205d,#090e24 75%);border-color:#5430a0}.eyebrow{font-size:11px;font-weight:900;letter-spacing:3px;color:#c5b5ff}.hero h1{font-size:clamp(35px,8vw,65px);line-height:1;margin:15px 0;font-weight:1000;letter-spacing:-2px;text-shadow:0 0 28px #8e45ff66}.hero h1 span{display:block;color:#ffcf4c}.sub{color:var(--muted);font-size:13px;line-height:1.6}.hero-art{display:flex;justify-content:center;gap:9px;margin:28px 0}.hero-art span{display:grid;place-items:center;width:clamp(45px,12vw,68px);aspect-ratio:1;background:#17264a;border:1px solid #7056bd;border-radius:19px;font-size:clamp(25px,6vw,38px);box-shadow:0 0 20px #773cff33}.hero-art span:nth-child(2),.hero-art span:nth-child(4){transform:translateY(-10px)}.hero-art span:nth-child(3){transform:translateY(-17px);border-color:var(--gold)}
.btn{border:0;border-radius:13px;padding:13px 16px;font-weight:900;display:inline-flex;justify-content:center;align-items:center;gap:8px;transition:.15s}.btn:hover{filter:brightness(1.12);transform:translateY(-1px)}.primary{background:linear-gradient(100deg,#ffbc32,#ff8e14);color:#180e1b;box-shadow:0 7px 24px #ff9d1830}.purple{background:linear-gradient(100deg,#8c35ff,#4b2bff);color:white}.secondary{background:#132143;border:1px solid #344a7c}.ghost{background:transparent;border:1px solid #34456c;color:#c9d5f4}.danger{background:#49182d;border:1px solid #ff4668;color:#ffdce4}.full{width:100%}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:18px}.feature{padding:12px 4px;border:1px solid #283860;border-radius:13px;background:#0b1537;color:#c6d3f3;font-size:11px}.feature b{display:block;font-size:21px;margin-bottom:5px}
.title{font-size:22px;font-weight:950;margin:0 0 5px}.muted{font-size:13px;color:var(--muted);line-height:1.5;margin:0 0 16px}.layout{display:grid;gap:14px}.players{display:grid;gap:8px}.player{display:grid;grid-template-columns:43px minmax(0,1fr) 36px;gap:8px;align-items:center;background:#0a1530;border:1px solid #2a3d68;border-radius:13px;padding:7px}.avatar{width:42px;height:42px;background:#19294d;border:1px solid #465c91;border-radius:12px;font-size:24px}.name{width:100%;min-width:0;background:transparent;color:white;border:1px solid transparent;border-radius:8px;padding:10px 7px}.name:focus{border-color:var(--purple);outline:none}.remove{border:0;border-radius:9px;background:#172644;height:34px}.add{width:100%;margin-top:9px;border:1px dashed #465b8a;background:#0b1530;color:#d0dcfa;border-radius:12px;padding:12px;font-weight:800}.setting{margin-top:12px;padding:13px;background:#09142e;border:1px solid #26385e;border-radius:14px}.setting label{font-size:12px;color:#bac8e8;display:block;margin-bottom:10px;font-weight:800}.stepper{display:flex;align-items:center;justify-content:space-between;gap:10px}.stepper button{width:38px;height:36px;border-radius:10px;border:1px solid #3c5281;background:#192c55;font-size:20px}.value{font-weight:950;font-size:22px}.toggle-row{display:flex;align-items:center;justify-content:space-between;padding:12px 2px;border-bottom:1px solid #1c2b4e;font-size:13px;color:#cbd6f1}.toggle-row:last-child{border:0}.toggle{width:44px;height:25px;border:0;border-radius:99px;background:#263657;padding:3px}.toggle span{display:block;width:19px;height:19px;border-radius:50%;background:white;transition:.2s}.toggle.on{background:#00b8df}.toggle.on span{transform:translateX(19px)}.actions{display:flex;gap:9px;margin-top:15px}.actions>*{flex:1}.note{font-size:11px;color:#8194c0;line-height:1.5;margin-top:12px}
.avatar-grid{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}.avatar-opt{width:45px;height:45px;border:1px solid #354b79;border-radius:12px;background:#111f40;font-size:25px}.avatar-opt.sel{border:2px solid var(--gold);box-shadow:0 0 14px #ffbd3544}
.progress-head{display:flex;justify-content:space-between;gap:10px;font-size:12px;font-weight:800;color:#bdcbed;margin-bottom:9px}.progress{height:7px;background:#1a2848;border-radius:99px;overflow:hidden;margin-bottom:17px}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--purple),var(--pink));transition:width .3s}
.turn{display:flex;justify-content:center;align-items:center;gap:12px;margin:14px 0 20px}.big-avatar{width:58px;height:58px;display:grid;place-items:center;font-size:34px;border-radius:18px;background:linear-gradient(145deg,#1c3564,#161034);border:1px solid #7961c3;box-shadow:0 0 22px #8c35ff30}.turn-name{font-size:21px;font-weight:950}.turn-sub{font-size:11px;color:#aab9df;margin-top:3px}
.wheel-wrap{position:relative;width:min(76vw,310px);aspect-ratio:1;margin:25px auto}.pointer{position:absolute;z-index:3;left:50%;top:-10px;transform:translateX(-50%);width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;border-bottom:0;border-top:29px solid #ffe15c;filter:drop-shadow(0 0 7px #ffba2d)}.wheel-ring{position:absolute;inset:0;padding:7px;border-radius:50%;background:conic-gradient(#00d7ff,#8538ff,#ff36c5,#ff9f24,#00e99d,#00d7ff);box-shadow:0 0 22px #00baff70}.wheel{position:relative;width:100%;height:100%;border:3px solid #eee5ff;border-radius:50%;overflow:hidden;background:conic-gradient(from -30deg,#ff9d24 0 60deg,#138cff 60deg 120deg,#8b39ff 120deg 180deg,#ff35bd 180deg 240deg,#00bc7a 240deg 300deg,#ffb92c 300deg);transition:transform 4s cubic-bezier(.12,.72,.12,1)}.wheel:after{content:"";position:absolute;inset:0;background:radial-gradient(circle,transparent 20%,#0002)}.wheel-label{position:absolute;z-index:1;left:50%;top:50%;width:76px;margin:-14px 0 0 -38px;text-align:center;font-size:12px;font-weight:950;line-height:1.2;text-shadow:0 2px 5px #0009}.wheel-label:nth-child(1){transform:rotate(30deg) translateY(-77px) rotate(-30deg)}.wheel-label:nth-child(2){transform:rotate(90deg) translateY(-77px) rotate(-90deg)}.wheel-label:nth-child(3){transform:rotate(150deg) translateY(-77px) rotate(-150deg)}.wheel-label:nth-child(4){transform:rotate(210deg) translateY(-77px) rotate(-210deg)}.wheel-label:nth-child(5){transform:rotate(270deg) translateY(-77px) rotate(-270deg)}.wheel-label:nth-child(6){transform:rotate(330deg) translateY(-77px) rotate(-330deg)}.wheel-center{position:absolute;z-index:2;left:50%;top:50%;transform:translate(-50%,-50%);width:50px;height:50px;border:3px solid white;border-radius:50%;display:grid;place-items:center;background:radial-gradient(circle at 35% 25%,#8feaff,#6a34ff 60%,#21115d);font-size:20px;box-shadow:0 0 20px #00cfff99}.hint{text-align:center;color:#aab9df;font-size:12px}
.challenge{--cat:var(--blue);border:1px solid var(--cat);border-radius:21px;padding:18px;background:linear-gradient(145deg,#101a35,#080f24);box-shadow:0 0 25px color-mix(in srgb,var(--cat) 14%,transparent)}.cat-head{display:flex;align-items:center;gap:10px;font-size:13px;font-weight:950;color:var(--cat);text-transform:uppercase;letter-spacing:1px}.cat-icon{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-size:21px;background:#17223e;border:1px solid var(--cat)}.challenge-text{font-size:clamp(20px,5vw,29px);font-weight:850;line-height:1.3;text-align:center;margin:25px 0;overflow-wrap:anywhere}.timer{text-align:center;font-size:23px;font-weight:950;color:var(--cat);margin-bottom:12px;font-variant-numeric:tabular-nums}.timer-bar{height:7px;border-radius:99px;background:#1a2847;overflow:hidden;margin-bottom:17px}.timer-bar span{display:block;width:100%;height:100%;background:var(--cat)}.result-buttons{display:grid;grid-template-columns:1fr 1fr;gap:9px}.done,.fail{padding:13px 7px;border-radius:14px;font-weight:950;display:flex;flex-direction:column;align-items:center;gap:4px}.done{background:linear-gradient(145deg,#064a3a,#062c2b);border:1px solid #00d991;color:#76ffd1}.fail{background:linear-gradient(145deg,#49172b,#2c1024);border:1px solid #ff426d;color:#ff9ab0}.result-buttons small{font-size:10px}
.score-list{display:grid;gap:8px;margin:16px 0}.score-row{display:grid;grid-template-columns:42px minmax(0,1fr) auto;gap:10px;align-items:center;background:#0a1530;border:1px solid #293b65;border-radius:13px;padding:10px}.score-avatar{width:40px;height:40px;border-radius:12px;display:grid;place-items:center;background:#19284b;font-size:25px}.score-name{font-weight:900;overflow-wrap:anywhere}.score-meta{font-size:11px;color:#a7b8df;margin-top:3px}.score-number{font-size:24px;font-weight:1000;color:var(--gold)}.mini-bar{height:4px;border-radius:99px;background:#1b2a4b;margin-top:7px;overflow:hidden}.mini-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--blue),var(--purple));border-radius:99px}.winner{text-align:center;padding:15px}.crown{font-size:54px;filter:drop-shadow(0 0 18px #ffc52f88)}.winner h2{font-size:clamp(29px,7vw,43px);margin:8px 0;color:var(--gold)}.winner-avatar{width:90px;height:90px;margin:18px auto 10px;display:grid;place-items:center;font-size:56px;border-radius:26px;background:linear-gradient(145deg,#293b70,#301450);border:2px solid var(--gold);box-shadow:0 0 34px #ffbe3c44}.toast{position:fixed;z-index:20;bottom:18px;left:50%;transform:translate(-50%,20px);opacity:0;pointer-events:none;background:#17264a;border:1px solid #526ca7;border-radius:12px;padding:12px 17px;transition:.2s;font-size:13px;font-weight:800;text-align:center;max-width:calc(100% - 30px)}.toast.show{opacity:1;transform:translate(-50%,0)}.modal-bg{position:fixed;inset:0;z-index:15;background:#02040ddd;display:grid;place-items:center;padding:18px}.modal{width:min(100%,430px);max-height:90vh;overflow:auto;background:#0b1430;border:1px solid #475b8e;border-radius:20px;padding:20px;box-shadow:0 20px 70px #000b}.modal p{font-size:13px;color:#b7c5e7;line-height:1.5}.confetti{position:fixed;inset:0;overflow:hidden;pointer-events:none;z-index:12}.confetti i{position:absolute;top:-15px;left:var(--x);width:8px;height:13px;background:hsl(var(--h),95%,62%);animation:fall var(--d) linear forwards}@keyframes fall{to{top:110vh;transform:translateX(var(--drift)) rotate(900deg)}}.footer{text-align:center;color:#7182ad;font-size:11px;line-height:1.6;padding:20px 0}.hidden{display:none!important}
@media(min-width:720px){.app{padding:24px}.layout{grid-template-columns:1.1fr .9fr;align-items:start}.layout .panel+.panel{margin-top:0}.wheel-wrap{width:290px}.challenge-text{min-height:95px;display:grid;place-items:center}}
@media(max-width:400px){.app{padding:11px}.panel{padding:14px}.hero{padding:25px 10px}.features{gap:5px}.feature{font-size:10px}.result-buttons{gap:6px}.done,.fail{font-size:12px}}
@media(prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
</style>
