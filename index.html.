S.timerId=setInterval(()=>{S.timer--;let t=$('#timer'),b=$('#timerbar');if(t)t.textContent=`00:${String(Math.max(0,S.timer)).padStart(2,'0')}`;if(b)b.style.width=`${Math.max(0,S.timer)/60*100}%`;if(S.timer<=10&&S.timer>0)sound(700,.045,'sine',.01);if(S.timer<=0){stopTimer();finish(false,true)}},1000)}
function skip(){let root=$('#modal');root.innerHTML=`<div class="modal-bg" id="skipbg"><div class="modal"><h2 class="title">Пропустить испытание?</h2><p>За пропуск начислится 0 баллов. Ход перейдёт следующему игроку.</p><div class="actions"><button class="btn ghost" id="keep">Остаться</button><button class="btn danger" id="skipok">Пропустить</button></div></div></div>`;$('#keep').onclick=()=>root.innerHTML='';$('#skipok').onclick=()=>{root.innerHTML='';finish(false,false,true)};$('#skipbg').onclick=e=>{if(e.target.id==='skipbg')root.innerHTML=''}}
function finish(ok,timeout=false,skipped=false){if(S.done)return;S.done=true;stopTimer();let p=current();p.turns++;if(ok){p.score++;p.completed++;chime();toast('Отлично! +1 балл 🎉')}else{p.failed++;sound(220,.16,'triangle',.04);toast(timeout?'Время вышло! 0 баллов':'0 баллов — следующий ход.')};result(ok,timeout,skipped)}
function result(ok,timeout,skipped){let p=current(),c=cats[S.current.key],last=S.round===S.turns.length-1;main.innerHTML=`<section class="panel" style="text-align:center;padding:27px 18px"><div style="font-size:52px">${ok?'🎉':timeout?'⏰':'↪️'}</div><h2 class="title" style="font-size:28px;margin-top:8px">${ok?'Испытание пройдено!':timeout?'Время вышло!':skipped?'Испытание пропущено':'Не выполнено'}</h2><p class="muted">${ok?'Отлично, балл твой!':'Ничего страшного — игра продолжается.'}</p><div class="turn"><div class="big-avatar">${p.avatar}</div><div><div class="turn-name">${esc(p.name)}</div><div class="turn-sub">${c.icon} ${c.name}</div></div></div><div class="setting" style="margin:15px 0"><div class="muted" style="margin:0">ТЕКУЩИЙ СЧЁТ</div><div style="font-size:35px;font-weight:1000;color:${ok?'var(--green)':'var(--gold)'}">${p.score} <span style="font-size:15px">баллов</span></div></div><button class="btn purple full" id="next">${last?'🏆 РЕЗУЛЬТАТЫ':'СЛЕДУЮЩИЙ ИГРОК →'}</button></section>`;$('#next').onclick=()=>{click();if(last){stopMusic();go('results');celebrate()}else{S.round++;go('ready')}}}
function plural(n){let x=n%100,y=n%10;return x>10&&x<20?'баллов':y===1?'балл':y>1&&y<5?'балла':'баллов'}
function results(){let sorted=S.players.slice().sort((a,b)=>b.score-a.score||b.completed-a.completed),w=sorted[0],tie=sorted.filter(p=>p.score===w.score).length>1;main.innerHTML=`<section class="panel"><div class="winner"><div class="crown">👑</div><div class="eyebrow">ИГРА ОКОНЧЕНА</div><h2>${tie?'У НАС НИЧЬЯ!':'ПОБЕДИТЕЛЬ!'}</h2><p class="muted">Поздравляем ${tie?'лидеров':'чемпиона'} испытаний</p><div class="winner-avatar">${w.avatar}</div><div style="font-size:25px;font-weight:1000">${esc(w.name)}</div><p class="sub">${w.score} ${plural(w.score)} · выполнено ${w.completed} из ${S.count}</p></div><h2 class="title">🏆 Таблица лидеров</h2><div class="score-list">${sorted.map((p,i)=>`<div class="score-row"><div class="score-avatar">${i===0?'👑':p.avatar}</div><div><div class="score-name">${esc(p.name)}</div><div class="score-meta">✓ ${p.completed} выполнено · ○ ${p.failed} не выполнено</div><div class="mini-bar"><span style="width:${p.score/S.count*100}%"></span></div></div><div class="score-number">${p.score}</div></div>`).join('')}</div><div class="actions"><button class="btn ghost" id="edit">⚙ Игроки</button><button class="btn purple" id="again">↻ ЕЩЁ РАЗ</button></div><button class="btn secondary full" id="home" style="margin-top:10px">На главную</button></section>`;$('#again').onclick=()=>{click();begin()};$('#edit').onclick=()=>{click();go('setup')};$('#home').onclick=()=>{click();stopMusic();go('home')}}
function celebrate(){if(!S.animations)return;let root=$('#confetti');root.innerHTML='';for(let i=0;i<85;i++){let el=document.createElement('i');el.style.setProperty('--h',Math.random()*360);el.style.setProperty('--x',Math.random()*100+'%');el.style.setProperty('--d',2.3+Math.random()*3+'s');el.style.setProperty('--drift',(Math.random()*220-110)+'px');el.style.animationDelay=Math.random()*.8+'s';root.appendChild(el)}setTimeout(()=>root.innerHTML='',6000);chime()}
function render(){header();if(S.screen==='home')home();else if(S.screen==='setup')setup();else if(S.screen==='ready')ready();else if(S.screen==='game')game();else if(S.screen==='results')results();if(!S.animations)main.querySelectorAll('section').forEach(x=>x.style.animation='none')}
render();
</script>
</body>
</html>
