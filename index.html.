
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#100d1c">
<title>КАВЕРЗА — Игра для компании</title>
<style>
:root {
  --bg:#100d1c;
  --panel:#1b1630;
  --panel2:#251d40;
  --text:#f7f3ff;
  --muted:#aaa0c6;
  --pink:#ff4fa3;
  --purple:#9b72ff;
  --blue:#54c8ff;
  --green:#55e6a5;
  --yellow:#ffd166;
}
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  background:radial-gradient(ellipse at top,#30204f 0%,var(--bg) 58%);
  color:var(--text);
}
button,input,select{font:inherit}
button{cursor:pointer;touch-action:manipulation}
button:focus-visible,input:focus-visible,select:focus-visible{
  outline:3px solid var(--blue);outline-offset:3px
}
button:disabled{opacity:.5;cursor:not-allowed}
.hidden{display:none!important}
.app{width:min(100% - 28px,760px);margin:auto;padding:22px 0 42px}
header{text-align:center;margin-bottom:24px}
.logo{
  font-size:clamp(36px,9vw,62px);font-weight:1000;letter-spacing:3px;
  line-height:1.05;
  background:linear-gradient(110deg,#fff 5%,#ff65b4 48%,#a78bff 90%);
  color:transparent;background-clip:text;
  filter:drop-shadow(0 5px 20px #9b72ff35)
}
.subtitle{color:var(--muted);font-size:14px;margin-top:9px}
.panel{
  background:linear-gradient(145deg,#211a37ed,#171226f5);
  border:1px solid #ffffff13;border-radius:24px;padding:22px;
  box-shadow:0 18px 60px #0003;margin-bottom:16px
}
h1,h2,h3,p{margin-top:0}
h2{font-size:23px;margin-bottom:8px}
h3{font-size:16px;margin-bottom:10px}
.muted{color:var(--muted);font-size:14px;line-height:1.5}
.field{margin:17px 0}
.field label{display:block;font-weight:700;font-size:14px;margin-bottom:8px}
input,select{
  width:100%;border:1px solid #ffffff20;background:#110d20;color:white;
  border-radius:12px;padding:13px 14px;min-width:0
}
input::placeholder{color:#766d8c}
.row{display:flex;gap:10px;align-items:center}
.row>*{flex:1;min-width:0}
.btn{
  border:0;border-radius:14px;padding:14px 18px;font-weight:850;
  transition:transform .15s,filter .15s;background:var(--panel2);color:white
}
.btn:active{transform:scale(.97)}
.btn-primary{
  color:#170e27;background:linear-gradient(100deg,#ff65b4,#a78bff);
  box-shadow:0 8px 25px #a16aff28
}
.btn-secondary{border:1px solid #ffffff1c;background:#ffffff09}
.btn-green{background:linear-gradient(100deg,#55e6a5,#b4f5ca);color:#10251c}
.btn-danger{background:#ff4f7540;border:1px solid #ff4f7550}
.btn-block{width:100%;margin-top:10px}
.player-list{display:grid;gap:9px;margin-top:12px}
.player-row{display:flex;align-items:center;gap:10px}
.player-number{
  flex:0 0 34px;height:34px;border-radius:11px;
  display:grid;place-items:center;background:#ffffff10;color:var(--muted);font-weight:800
}
.player-row input{flex:1}
.section-title{display:flex;justify-content:space-between;align-items:center;gap:10px}
.small-btn{border:0;background:transparent;color:var(--blue);font-weight:800;padding:8px}
.categories{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin-top:14px}
.category{
  padding:12px;border-radius:14px;background:#ffffff07;border:1px solid #ffffff13;
  display:flex;gap:9px;align-items:center;font-size:13px;font-weight:750
}
.category input{width:18px;height:18px;accent-color:var(--pink);flex:0 0 auto}
.category .emoji{font-size:22px}
.topbar{display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap;margin-bottom:16px}
.pill{padding:8px 12px;border-radius:30px;background:#ffffff0c;color:#dcd3f7;font-size:13px;font-weight:750}
.player-card{text-align:center;padding:16px 10px}
.avatar{font-size:54px;margin:4px 0 8px}
.player-name{font-size:26px;font-weight:900;overflow-wrap:anywhere}
.round-info{color:var(--muted);font-size:13px;margin-top:6px}
.wheel-wrap{position:relative;width:min(78vw,340px);margin:18px auto 24px}
.pointer{
  position:absolute;z-index:3;left:50%;top:-9px;transform:translateX(-50%);
  width:0;height:0;border-left:17px solid transparent;border-right:17px solid transparent;
  border-top:30px solid white;filter:drop-shadow(0 4px 6px #0009)
}
.wheel{
  width:100%;aspect-ratio:1;border-radius:50%;
  border:7px solid #ffffffea;
  background:conic-gradient(
    #ff568d 0deg 60deg,
    #a56bff 60deg 120deg,
    #3fbbf5 120deg 180deg,
    #43d9a0 180deg 240deg,
    #ffbd4a 240deg 300deg,
    #f36bd5 300deg 360deg
  );
  position:relative;overflow:hidden;
  box-shadow:0 0 0 7px #ffffff12,0 18px 55px #0005;
  transition:transform 3.3s cubic-bezier(.12,.72,.12,1)
}
.wheel-label{
  position:absolute;left:50%;top:50%;width:74px;
  margin-left:-37px;margin-top:-13px;text-align:center;
  font-size:12px;font-weight:950;color:#1a1030;
  transform:rotate(var(--angle)) translateY(-105px) rotate(calc(-1 * var(--angle)));
  text-shadow:0 1px #ffffff80;line-height:1.2
}
.wheel-center{
  position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);
  width:66px;height:66px;border-radius:50%;background:#171126;
  border:4px solid #fff;display:grid;place-items:center;font-size:26px;
  box-shadow:0 3px 12px #0005
}
.category-badge{
  display:inline-flex;align-items:center;gap:8px;padding:9px 14px;
  border-radius:30px;background:#ffffff10;font-size:13px;font-weight:850
}
.challenge{text-align:center}
.challenge-text{
  font-size:clamp(22px,5.5vw,31px);font-weight:850;line-height:1.35;
  margin:20px 0;overflow-wrap:anywhere
}
.timer{
  font-size:42px;font-weight:950;font-variant-numeric:tabular-nums;
  margin:10px 0 3px;color:var(--green)
}
.timer.warning{color:var(--pink);animation:pulse .8s infinite alternate}
@keyframes pulse{to{transform:scale(1.06)}}
.timer-track{height:7px;background:#ffffff12;border-radius:10px;overflow:hidden;margin:12px 0}
.timer-fill{height:100%;width:100%;background:var(--green);transition:width .25s linear}
.challenge-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.challenge-actions .btn{padding:15px 8px}
.score-list{display:grid;gap:9px;margin:16px 0}
.score-row{
  display:flex;align-items:center;gap:12px;padding:12px;
  border-radius:14px;background:#ffffff08
}
.score-avatar{font-size:25px}
.score-name{flex:1;font-weight:800;overflow-wrap:anywhere}
.score-value{font-size:20px;font-weight:950;color:var(--green)}
.result-icon{font-size:62px;text-align:center;margin:6px}
.center{text-align:center}
.footer{text-align:center;color:#756b8e;font-size:12px;margin-top:24px}
.toast{
  position:fixed;bottom:18px;left:50%;transform:translateX(-50%);
  background:#29203f;color:white;border:1px solid #ffffff20;border-radius:14px;
  padding:12px 18px;z-index:10;box-shadow:0 8px 30px #0007;
  max-width:calc(100% - 30px);text-align:center
}
@media(min-width:600px){
  .panel{padding:26px}
  .categories{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.01ms!important;transition-duration:.01ms!important}
}
</style>
</head>
<body>
<div class="app">
  <header>
    <div class="logo">КАВЕРЗА</div>
    <div class="subtitle">Игра для компании · Испытай удачу</div>
  </header>

  <main>
    <section id="setupScreen">
      <div class="panel">
        <h2>🎮 Собирайте компанию</h2>
        <p class="muted">Добавьте игроков, выберите категории и начните игру. За выполненные испытания начисляются очки.</p>

        <div class="field">
          <div class="section-title">
            <label>Игроки (от 2 до 10)</label>
            <button type="button" class="small-btn" id="addPlayerBtn">+ Добавить</button>
          </div>
          <div id="playerInputs" class="player-list"></div>
        </div>

        <div class="field">
          <label for="roundsInput">Количество раундов на игрока</label>
          <select id="roundsInput">
            <option value="5">5 раундов</option>
            <option value="7">7 раундов</option>
            <option value="10" selected>10 раундов</option>
            <option value="15">15 раундов</option>
          </select>
        </div>

        <div class="field">
          <label>Категории испытаний</label>
          <div class="categories" id="categoryChoices">
            <label class="category"><input type="checkbox" value="question" checked><span class="emoji">💬</span> Вопрос</label>
            <label class="category"><input type="checkbox" value="action" checked><span class="emoji">⚡</span> Действие</label>
            <label class="category"><input type="checkbox" value="dare" checked><span class="emoji">🔥</span> Вызов</label>
            <label class="category"><input type="checkbox" value="reveal" checked><span class="emoji">🤫</span> Откровение</label>
            <label class="category"><input type="checkbox" value="twist" checked><span class="emoji">🌀</span> Каверза</label>
            <label class="category"><input type="checkbox" value="bonus" checked><span class="emoji">⭐</span> Бонус</label>
          </div>
        </div>

        <button type="button" class="btn btn-primary btn-block" id="startBtn">НАЧАТЬ ИГРУ →</button>
      </div>
      <div class="panel">
        <h3>📜 Правила</h3>
        <p class="muted">Игроки ходят по очереди. Рулетка определяет категорию, затем появляется случайное испытание. Выполнил — получи очки. Не хочешь выполнять — пропусти ход без очков. Можно играть без таймера, если закончится время — испытание автоматически считается пропущенным.</p>
      </div>
    </section>

    <section id="gameScreen" class="hidden">
      <div class="topbar">
        <span class="pill" id="progressPill">Раунд 1</span>
        <span class="pill" id="scorePill">Очки: 0</span>
      </div>

      <div class="panel player-card">
        <div class="avatar" id="currentAvatar">🎮</div>
        <div class="muted">Сейчас ходит</div>
        <div class="player-name" id="currentPlayer">Игрок</div>
        <div class="round-info" id="turnInfo"></div>
      </div>

      <div class="panel center" id="wheelPanel">
        <h2>🎯 Крути рулетку</h2>
        <p class="muted">Категория выбирается случайно</p>
        <div class="wheel-wrap">
          <div class="pointer"></div>
          <div class="wheel" id="wheel">
            <span class="wheel-label" style="--angle:30deg">💬<br>ВОПРОС</span>
            <span class="wheel-label" style="--angle:90deg">⚡<br>ДЕЙСТВИЕ</span>
            <span class="wheel-label" style="--angle:150deg">🔥<br>ВЫЗОВ</span>
            <span class="wheel-label" style="--angle:210deg">🤫<br>ОТКРОВЕНИЕ</span>
            <span class="wheel-label" style="--angle:270deg">🌀<br>КАВЕРЗА</span>
            <span class="wheel-label" style="--angle:330deg">⭐<br>БОНУС</span>
            <div class="wheel-center">🎲</div>
          </div>
        </div>
        <button type="button" class="btn btn-primary btn-block" id="spinBtn">КРУТИТЬ РУЛЕТКУ</button>
      </div>

      <div class="panel challenge hidden" id="challengePanel">
        <div class="category-badge" id="categoryBadge">💬 ВОПРОС</div>
        <div class="challenge-text" id="challengeText"></div>
        <div id="timerArea">
          <div class="timer" id="timer">60</div>
          <div class="muted">секунд на выполнение</div>
          <div class="timer-track"><div class="timer-fill" id="timerFill"></div></div>
        </div>
        <div class="challenge-actions">
          <button type="button" class="btn btn-green" id="doneBtn">✓ Выполнено</button>
          <button type="button" class="btn btn-danger" id="skipBtn">✕ Пропустить</button>
        </div>
      </div>

      <div class="panel">
        <div class="section-title"><h3>🏆 Таблица очков</h3><span class="muted">Топ игроков</span></div>
        <div class="score-list" id="scoreList"></div>
      </div>

      <button type="button" class="btn btn-secondary btn-block" id="endBtn">Завершить игру</button>
    </section>

    <section id="resultScreen" class="hidden">
      <div class="panel center">
        <div class="result-icon">🏆</div>
        <h2>Игра окончена!</h2>
        <p class="muted">Вот результаты вашей компании</p>
        <div id="winnerText" class="challenge-text"></div>
        <div class="score-list" id="finalScoreList"></div>
        <button type="button" class="btn btn-primary btn-block" id="againBtn">ИГРАТЬ СНОВА</button>
        <button type="button" class="btn btn-secondary btn-block" id="setupAgainBtn">Изменить игроков и настройки</button>
      </div>
    </section>
  </main>
  <div class="footer">КАВЕРЗА · Играйте весело и уважайте границы друг друга</div>
</div>

<div id="toast" class="toast hidden" role="status" aria-live="polite"></div>

<script>
"use strict";

const $ = selector => document.querySelector(selector);
const $$ = selector => [...document.querySelectorAll(selector)];

const categories = {
  question: {
    name:"ВОПРОС", emoji:"💬", points:1,
    tasks:[
      "Какой самый нелепый поступок ты совершал?",
