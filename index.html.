      "Придумай новое правило, которое действует один раунд.",
      "Опиши одного игрока как персонажа видеоигры.",
      "Расскажи сказку, в которой главный герой — тапок."
    ]
  },
  bonus: {
    name:"БОНУС", emoji:"⭐", points:0,
    tasks:[
      "Получай 2 дополнительных очка!",
      "Выбери игрока, который получит 1 бонусное очко.",
      "Получай 3 очка, если назовёшь пять любимых блюд за десять секунд.",
      "Все игроки получают по одному очку.",
      "Получай 2 очка и придумай себе игровой титул.",
      "Выбери игрока, который должен сказать тебе комплимент.",
      "Получай 1 очко и передай ход следующему игроку.",
      "Получай 2 очка за самый громкий победный возглас.",
      "Получай 3 очка, если расскажешь короткий анекдот.",
      "Все игроки, кроме тебя, хлопают три раза — ты получаешь 1 очко.",
      "Получай 2 очка и выбери следующую категорию наугад.",
      "Выбери игрока для совместного испытания: оба получаете по 1 очку.",
      "Получай 1 очко за честный ответ на вопрос остальных.",
      "Получай 2 очка, если назовёшь пять фруктов за пять секунд.",
      "Объяви себя капитаном команды до следующего раунда.",
      "Получай 2 очка и придумай девиз компании.",
      "Получай 1 очко и назначь следующего игрока.",
      "Получай 3 очка, если все игроки согласятся с твоим тостом.",
      "Получай 2 очка за самую убедительную победную речь.",
      "Получай 1 очко просто за удачу!"
    ]
  }
};

const avatars = ["😎","🦊","🐼","🐸","🐯","🐙","🐺","🦄","🐲","👽"];

const state = {
  players: [],
  rounds: 10,
  turn: 0,
  turnsTaken: 0,
  maxTurns: 0,
  currentCategory: null,
  currentTask: null,
  usedTasks: {},
  spinning: false,
  taskActive: false,
  timerId: null,
  seconds: 60,
  wheelAngle: 0,
  gameStarted: false
};

let toastTimeout = null;

function showToast(message) {
  const toast = $("#toast");
  toast.textContent = message;
  toast.classList.remove("hidden");
  clearTimeout(toastTimeout);
  toastTimeout = setTimeout(() => toast.classList.add("hidden"), 2400);
}

function shuffle(array) {
  const result = [...array];
  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }
  return result;
}

function renderPlayerInputs(names = null) {
  const container = $("#playerInputs");
  const currentNames = names || $$("#playerInputs input").map(input => input.value);
  const count = Math.max(2, Math.min(10, currentNames.length || 2));

  container.innerHTML = "";
  for (let i = 0; i < count; i++) {
    const row = document.createElement("div");
    row.className = "player-row";

    const number = document.createElement("div");
    number.className = "player-number";
    number.textContent = String(i + 1);

    const input = document.createElement("input");
    input.type = "text";
    input.maxLength = 24;
    input.autocomplete = "off";
    input.placeholder = `Имя игрока ${i + 1}`;
    input.setAttribute("aria-label", `Имя игрока ${i + 1}`);
    input.value = currentNames[i] || "";

    row.append(number, input);
    container.appendChild(row);
  }

  $("#addPlayerBtn").disabled = count >= 10;
  $("#addPlayerBtn").textContent = count >= 10 ? "Максимум 10" : "+ Добавить";
}

function getEnabledCategories() {
  return $$("#categoryChoices input:checked")
    .map(input => input.value)
    .filter(key => categories[key]);
}

function startGame() {
  const names = $$("#playerInputs input")
    .map(input => input.value.trim())
    .filter(Boolean);

  if (names.length < 2) {
    showToast("Введите имена минимум двух игроков");
    return;
  }

  const enabled = getEnabledCategories();
  if (!enabled.length) {
    showToast("Выберите хотя бы одну категорию");
    return;
  }

  state.players = names.map((name, index) => ({
    name,
    avatar: avatars[index % avatars.length],
    score: 0,
    turns: 0
  }));
  state.rounds = Number($("#roundsInput").value) || 10;
  state.turn = 0;
  state.turnsTaken = 0;
  state.maxTurns = state.players.length * state.rounds;
  state.currentCategory = null;
  state.currentTask = null;
  state.usedTasks = {};
  state.spinning = false;
  state.taskActive = false;
  state.wheelAngle = 0;
  state.gameStarted = true;

  $("#wheel").style.transition = "none";
  $("#wheel").style.transform = "rotate(0deg)";
  $("#wheel").offsetHeight;
  $("#wheel").style.transition = "";

  $("#setupScreen").classList.add("hidden");
  $("#resultScreen").classList.add("hidden");
  $("#gameScreen").classList.remove("hidden");
  $("#wheelPanel").classList.remove("hidden");
  $("#challengePanel").classList.add("hidden");
  $("#spinBtn").disabled = false;
  $("#endBtn").disabled = false;

  updateGameUI();
  showToast("Игра началась! Удачи!");
}

function updateGameUI() {
  if (!state.players.length) return;
  const player = state.players[state.turn];

  $("#currentAvatar").textContent = player.avatar;
  $("#currentPlayer").textContent = player.name;
  $("#progressPill").textContent = `Ход ${state.turnsTaken + 1} из ${state.maxTurns}`;
  $("#scorePill").textContent = `Очки: ${player.score}`;
  $("#turnInfo").textContent = `Личный раунд ${player.turns + 1} из ${state.rounds}`;

  const sorted = [...state.players].sort((a, b) => b.score - a.score);
  const list = $("#scoreList");
  list.innerHTML = "";

  sorted.forEach((p, index) => {
    const row = document.createElement("div");
    row.className = "score-row";

    const avatar = document.createElement("span");
    avatar.className = "score-avatar";
    avatar.textContent = p.avatar;

    const name = document.createElement("span");
    name.className = "score-name";
    name.textContent = `${index + 1}. ${p.name}`;

    const score = document.createElement("span");
    score.className = "score-value";
    score.textContent = String(p.score);

    row.append(avatar, name, score);
    list.appendChild(row);
  });
}

function pickTask(categoryKey) {
  const tasks = categories[categoryKey].tasks;
  if (!state.usedTasks[categoryKey]) state.usedTasks[categoryKey] = [];

  let available = tasks.filter(task => !state.usedTasks[categoryKey].includes(task));
  if (!available.length) {
    state.usedTasks[categoryKey] = [];
    available = [...tasks];
  }

  const task = available[Math.floor(Math.random() * available.length)];
  state.usedTasks[categoryKey].push(task);
  return task;
}

function spinWheel() {
  if (state.spinning || state.taskActive || !state.gameStarted) return;

  const enabled = getEnabledCategories();
  if (!enabled.length) {
    showToast("Не выбрана ни одна категория");
    return;
  }

  state.spinning = true;
  $("#spinBtn").disabled = true;

  const categoryKey = enabled[Math.floor(Math.random() * enabled.length)];
  const categoryIndex = Object.keys(categories).indexOf(categoryKey);

  // Каждый сектор занимает 60 градусов. Указатель сверху.
  // Поворачиваем колесо так, чтобы выбранный сектор оказался под указателем.
  const sectorCenter = categoryIndex * 60 + 30;
  const currentMod = ((state.wheelAngle % 360) + 360) % 360;
  const targetMod = (360 - sectorCenter + 360) % 360;
  const correction = (targetMod - currentMod + 360) % 360;
  state.wheelAngle += 1440 + correction;

  $("#wheel").style.transform = `rotate(${state.wheelAngle}deg)`;

  setTimeout(() => {
    state.spinning = false;
    state.currentCategory = categoryKey;
    state.currentTask = pickTask(categoryKey);
    showChallenge();
  }, 3400);
}

function showChallenge() {
  const category = categories[state.currentCategory];
  if (!category || !state.currentTask) return;

  $("#wheelPanel").classList.add("hidden");
  $("#challengePanel").classList.remove("hidden");
  $("#categoryBadge").textContent = `${category.emoji} ${category.name}`;
  $("#challengeText").textContent = state.currentTask;
  $("#doneBtn").disabled = false;
  $("#skipBtn").disabled = false;

  state.taskActive = true;
  state.seconds = 60;
  $("#timerArea").classList.remove("hidden");
  updateTimerUI();
  clearInterval(state.timerId);

  state.timerId = setInterval(() => {
    state.seconds--;
    updateTimerUI();

    if (state.seconds <= 0) {
      clearInterval(state.timerId);
      state.timerId = null;
      finishTurn(false, true);
    }
  }, 1000);
}

function updateTimerUI() {
  const timer = $("#timer");
  timer.textContent = String(Math.max(0, state.seconds));
  timer.classList.toggle("warning", state.seconds <= 10);
  $("#timerFill").style.width = `${Math.max(0, state.seconds / 60 * 100)}%`;
  $("#timerFill").style.background = state.seconds <= 10 ? "var(--pink)" : "var(--green)";
}

function applyBonus(taskText) {
  const player = state.players[state.turn];

  if (/Все игроки получают по одному очку/.test(taskText)) {
    state.players.forEach(p => p.score++);
    return "Все игроки получили по 1 очку!";
  }

  const fixed = taskText.match(/Получай (\d+) (?:дополнительных )?очка?/i);
  if (fixed && /Получай \d+ (?:дополнительных )?очка?/.test(taskText)) {
    const points = Number(fixed[1]);
    player.score += points;
    return `${player.name} получает ${points} очк.`;
  }

  if (/Получай 1 очко/.test(taskText)) {
    player.score += 1;
    return `${player.name} получает 1 очко.`;
  }

  if (/Получай 2 очка/.test(taskText)) {
    player.score += 2;
    return `${player.name} получает 2 очка.`;
  }

  if (/Получай 3 очка/.test(taskText)) {
    player.score += 3;
    return `${player.name} получает 3 очка.`;
  }

  if (/Выбери игрока/.test(taskText)) {
    const others = state.players.filter(p => p !== player);
    if (others.length) {
      const chosen = others[Math.floor(Math.random() * others.length)];
      chosen.score++;
      return `${chosen.name} получает 1 бонусное очко!`;
    }
  }

  if (/оба получаете по 1 очку/.test(taskText)) {
    const others = state.players.filter(p => p !== player);
    player.score++;
    if (others.length) others[Math.floor(Math.random() * others.length)].score++;
    return "Участники совместного испытания получают по очку!";
  }

  if (/капитаном команды/.test(taskText)) {
    player.score++;
    return `${player.name} становится капитаном и получает 1 очко!`;
  }

  return "Бонусное испытание!";
}

function finishTurn(completed, timedOut = false) {
  if (!state.taskActive) return;

  clearInterval(state.timerId);
  state.timerId = null;
  state.taskActive = false;

  const player = state.players[state.turn];
  const categoryKey = state.currentCategory;
  const category = categories[categoryKey];
  let message = "";

  if (completed) {
    if (categoryKey === "bonus") {
      message = applyBonus(state.currentTask);
    } else {
      player.score += category.points;
      message = `${player.name} получает ${category.points} очк.`;
    }
  } else {
    message = timedOut ? "Время вышло — испытание пропущено." : "Испытание пропущено. Очки не начислены.";
  }

  state.turnsTaken++;
  player.turns++;

  $("#challengePanel").classList.add("hidden");
  $("#wheelPanel").classList.remove("hidden");

  if (state.turnsTaken >= state.maxTurns) {
    updateGameUI();
    showToast(message);
    setTimeout(showResults, 700);
    return;
  }

  // Следующий игрок по кругу.
  state.turn = (state.turn + 1) % state.players.length;
  updateGameUI();
  $("#spinBtn").disabled = false;
  showToast(message);
}

function showResults() {
  clearInterval(state.timerId);
  state.timerId = null;
  state.gameStarted = false;
  state.taskActive = false;
  state.spinning = false;

  $("#gameScreen").classList.add("hidden");
  $("#setupScreen").classList.add("hidden");
  $("#resultScreen").classList.remove("hidden");

  const sorted = [...state.players].sort((a, b) => b.score - a.score);
  const winners = sorted.filter(p => p.score === sorted[0].score);
  $("#winnerText").textContent = winners.length > 1
    ? `🤝 Ничья: ${winners.map(p => p.name).join(", ")}!`
    : `👑 Победитель — ${winners[0].name}!`;

  const list = $("#finalScoreList");
  list.innerHTML = "";

  sorted.forEach((p, index) => {
    const row = document.createElement("div");
    row.className = "score-row";

    const avatar = document.createElement("span");
    avatar.className = "score-avatar";
    avatar.textContent = p.avatar;

    const name = document.createElement("span");
    name.className = "score-name";
    name.textContent = `${index + 1}. ${p.name}`;

    const score = document.createElement("span");
    score.className = "score-value";
    score.textContent = `${p.score} ★`;

    row.append(avatar, name, score);
    list.appendChild(row);
  });
}

function stopGame() {
  if (!state.gameStarted) return;
  const confirmed = window.confirm("Завершить игру и показать текущие результаты?");
  if (!confirmed) return;

  clearInterval(state.timerId);
  state.timerId = null;
  state.taskActive = false;
  state.spinning = false;
  showResults();
}

function playAgain() {
  if (!state.players.length) {
    $("#resultScreen").classList.add("hidden");
    $("#setupScreen").classList.remove("hidden");
    return;
  }

  const names = state.players.map(p => p.name);
  renderPlayerInputs(names);
  startGame();
}

function returnToSetup() {
  clearInterval(state.timerId);
  state.timerId = null;
  state.gameStarted = false;
  state.taskActive = false;
  state.spinning = false;

  $("#gameScreen").classList.add("hidden");
  $("#resultScreen").classList.add("hidden");
  $("#setupScreen").classList.remove("hidden");
}

$("#addPlayerBtn").addEventListener("click", () => {
  const names = $$("#playerInputs input").map(input => input.value);
  if (names.length >= 10) return;
  names.push("");
  renderPlayerInputs(names);
  const inputs = $$("#playerInputs input");
  inputs[inputs.length - 1].focus();
});

$("#startBtn").addEventListener("click", startGame);
$("#spinBtn").addEventListener("click", spinWheel);
$("#doneBtn").addEventListener("click", () => finishTurn(true));
$("#skipBtn").addEventListener("click", () => finishTurn(false));
$("#endBtn").addEventListener("click", stopGame);
$("#againBtn").addEventListener("click", playAgain);
$("#setupAgainBtn").addEventListener("click", returnToSetup);

// Стартовая форма: два игрока по умолчанию.
renderPlayerInputs(["Игрок 1", "Игрок 2"]);
</script>
